{
  "info": {
    "name": "Checkout + Orders + Payment API",
    "description": "Postman collection for the Checkout, Orders and Payment backend module.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api/v1" },
    { "key": "customerToken", "value": "" },
    { "key": "adminToken", "value": "" },
    { "key": "orderId", "value": "" },
    { "key": "productId", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register Customer",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ahmed Ali\",\n  \"email\": \"ahmed@example.com\",\n  \"password\": \"password123\",\n  \"phone\": \"01012345678\",\n  \"role\": \"customer\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] }
          }
        },
        {
          "name": "Register Admin",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Admin User\",\n  \"email\": \"admin@example.com\",\n  \"password\": \"password123\",\n  \"phone\": \"01099998888\",\n  \"role\": \"admin\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ahmed@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        }
      ]
    },
    {
      "name": "Checkout",
      "item": [
        {
          "name": "Checkout (Cash on Delivery)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"01098765432\",\n  \"governorate\": \"Cairo\",\n  \"address\": \"123 Tahrir Street, Downtown\",\n  \"deliveryNotes\": \"Leave with doorman\",\n  \"orderNotes\": \"Gift wrap please\",\n  \"paymentMethod\": \"cash_on_delivery\",\n  \"items\": [\n    { \"product\": \"{{productId}}\", \"quantity\": 2 }\n  ]\n}"
            },
            "url": { "raw": "{{baseUrl}}/checkout", "host": ["{{baseUrl}}"], "path": ["checkout"] }
          }
        },
        {
          "name": "Checkout (Electronic Wallet)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"01098765432\",\n  \"governorate\": \"Giza\",\n  \"address\": \"456 Haram Street\",\n  \"paymentMethod\": \"electronic_wallet\",\n  \"walletPhone\": \"01098765432\",\n  \"items\": [\n    { \"product\": \"{{productId}}\", \"quantity\": 1 }\n  ]\n}"
            },
            "url": { "raw": "{{baseUrl}}/checkout", "host": ["{{baseUrl}}"], "path": ["checkout"] }
          }
        }
      ]
    },
    {
      "name": "Orders",
      "item": [
        {
          "name": "Get My Orders (paginated/search/filter)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/orders/my-orders?page=1&limit=10&status=pending&search=Cairo",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "my-orders"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "status", "value": "pending" },
                { "key": "search", "value": "Cairo" }
              ]
            }
          }
        },
        {
          "name": "Get Order Details",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": { "raw": "{{baseUrl}}/orders/{{orderId}}", "host": ["{{baseUrl}}"], "path": ["orders", "{{orderId}}"] }
          }
        },
        {
          "name": "Cancel Order",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"reason\": \"Changed my mind\"\n}" },
            "url": { "raw": "{{baseUrl}}/orders/{{orderId}}/cancel", "host": ["{{baseUrl}}"], "path": ["orders", "{{orderId}}", "cancel"] }
          }
        },
        {
          "name": "Admin - Get All Orders (paginated/search/filter)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/orders?page=1&limit=10&status=pending&sort=-createdAt",
              "host": ["{{baseUrl}}"],
              "path": ["orders"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "status", "value": "pending" },
                { "key": "sort", "value": "-createdAt" }
              ]
            }
          }
        },
        {
          "name": "Admin - Update Order Status",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"confirmed\",\n  \"note\": \"Stock verified\"\n}" },
            "url": { "raw": "{{baseUrl}}/orders/{{orderId}}/status", "host": ["{{baseUrl}}"], "path": ["orders", "{{orderId}}", "status"] }
          }
        }
      ]
    },
    {
      "name": "Payment",
      "item": [
        {
          "name": "Upload Payment Proof",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [{ "key": "paymentProof", "type": "file", "src": "" }]
            },
            "url": { "raw": "{{baseUrl}}/orders/{{orderId}}/payment-proof", "host": ["{{baseUrl}}"], "path": ["orders", "{{orderId}}", "payment-proof"] }
          }
        },
        {
          "name": "Get Payment Status",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": { "raw": "{{baseUrl}}/orders/{{orderId}}/payment-status", "host": ["{{baseUrl}}"], "path": ["orders", "{{orderId}}", "payment-status"] }
          }
        },
        {
          "name": "Admin - Update Payment Status",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"paymentStatus\": \"paid\"\n}" },
            "url": { "raw": "{{baseUrl}}/orders/{{orderId}}/payment-status", "host": ["{{baseUrl}}"], "path": ["orders", "{{orderId}}", "payment-status"] }
          }
        }
      ]
    }
  ]
}
