{
  "info": {
    "name": "ToQa API",
    "description": "Core customer and admin flows for the ToQa REST API.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api/v1" },
    { "key": "token", "value": "" },
    { "key": "adminToken", "value": "" },
    { "key": "sessionId", "value": "" },
    { "key": "productId", "value": "" },
    { "key": "variantId", "value": "" },
    { "key": "orderId", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "request": { "method": "GET", "url": "{{baseUrl}}/health" }
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Test Customer\",\n  \"email\": \"customer@example.com\",\n  \"password\": \"Password123\",\n  \"phone\": \"01000000000\"\n}" },
            "url": "{{baseUrl}}/auth/register"
          },
          "event": [{ "listen": "test", "script": { "exec": ["const json = pm.response.json();", "if (json.data?.token) pm.collectionVariables.set('token', json.data.token);"] } }]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"customer@example.com\",\n  \"password\": \"Password123\"\n}" },
            "url": "{{baseUrl}}/auth/login"
          },
          "event": [{ "listen": "test", "script": { "exec": ["const json = pm.response.json();", "if (json.data?.token) pm.collectionVariables.set('token', json.data.token);"] } }]
        }
      ]
    },
    {
      "name": "Catalog",
      "item": [
        { "name": "List Products", "request": { "method": "GET", "url": "{{baseUrl}}/products?page=1&limit=12" } },
        { "name": "Product Details", "request": { "method": "GET", "url": "{{baseUrl}}/products/{{productId}}" } },
        { "name": "Categories", "request": { "method": "GET", "url": "{{baseUrl}}/categories" } }
      ]
    },
    {
      "name": "Cart and Checkout",
      "item": [
        {
          "name": "Get Cart",
          "request": { "method": "GET", "header": [{ "key": "x-session-id", "value": "{{sessionId}}" }], "url": "{{baseUrl}}/cart" },
          "event": [{ "listen": "test", "script": { "exec": ["const value = pm.response.headers.get('x-session-id');", "if (value) pm.collectionVariables.set('sessionId', value);"] } }]
        },
        {
          "name": "Add Item",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "x-session-id", "value": "{{sessionId}}" }], "body": { "mode": "raw", "raw": "{\n  \"variantId\": \"{{variantId}}\",\n  \"quantity\": 1\n}" }, "url": "{{baseUrl}}/cart/items" }
        },
        {
          "name": "Checkout",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "x-session-id", "value": "{{sessionId}}" }], "body": { "mode": "raw", "raw": "{\n  \"customer\": {\"name\": \"Guest Customer\", \"phone\": \"01000000000\", \"email\": \"guest@example.com\"},\n  \"deliveryAddress\": \"12 Example Street\",\n  \"governorate\": \"Cairo\",\n  \"paymentMethod\": \"cash_on_delivery\"\n}" }, "url": "{{baseUrl}}/checkout" },
          "event": [{ "listen": "test", "script": { "exec": ["const json = pm.response.json();", "if (json.data?.order?._id) pm.collectionVariables.set('orderId', json.data.order._id);"] } }]
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        { "name": "Dashboard", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": "{{baseUrl}}/admin/dashboard" } },
        { "name": "Low Stock", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": "{{baseUrl}}/admin/inventory/low-stock" } },
        { "name": "Orders", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": "{{baseUrl}}/admin/orders" } }
      ]
    }
  ]
}
