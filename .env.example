# ── Server ────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── Database ──────────────────────────────────────────────
MONGO_URI=mongodb://127.0.0.1:27017/toqa

# ── JWT ───────────────────────────────────────────────────
# Use long, random strings in real environments (e.g. `openssl rand -hex 64`)
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d
# Cookie expiry should track JWT_EXPIRES_IN, expressed in days
JWT_COOKIE_EXPIRES_DAYS=1

# ── Password hashing ──────────────────────────────────────
BCRYPT_SALT_ROUNDS=12

# ── CORS ──────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000

# ── Rate limiting ─────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
