# Server
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/checkout_orders_payment

# JWT
JWT_SECRET=change_this_super_secret_key
JWT_EXPIRES_IN=7d

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# File upload
MAX_FILE_SIZE_MB=5

# Logging
LOG_LEVEL=info
